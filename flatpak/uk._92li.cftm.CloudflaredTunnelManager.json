{
  "app-id": "uk._92li.cftm.CloudflaredTunnelManager",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "cloudflared-tunnel-manager",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--share=network"
  ],
  "modules": [
    {
      "name": "cloudflared-tunnel-manager",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/cftm /app/bin",
        "cp -r cftm main.py data /app/share/cftm/",
        "printf '#!/bin/sh\\nexec python3 /app/share/cftm/main.py \"$@\"\\n' > /app/bin/cloudflared-tunnel-manager",
        "chmod 755 /app/bin/cloudflared-tunnel-manager",
        "install -Dm644 data/uk._92li.cftm.CloudflaredTunnelManager.desktop /app/share/applications/uk._92li.cftm.CloudflaredTunnelManager.desktop",
        "install -Dm644 data/uk._92li.cftm.CloudflaredTunnelManager.metainfo.xml /app/share/metainfo/uk._92li.cftm.CloudflaredTunnelManager.metainfo.xml",
        "install -Dm644 data/uk._92li.cftm.CloudflaredTunnelManager.svg /app/share/icons/hicolor/scalable/apps/uk._92li.cftm.CloudflaredTunnelManager.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
